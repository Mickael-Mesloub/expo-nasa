{
  "expo": {
    "name": "Expo-Nasa",
    "slug": "Expo-Nasa-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/assets/icons/splash-icon-dark.png",
    "scheme": "exponasa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "src/assets/icons/splash-icon-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "icon": {
        "dark": "src/assets/icons/ios-dark.png",
        "light": "src/assets/icons/ios-light.png",
        "tinted": "src/assets/icons/ios-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "MickaelMesloub",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "src/assets/icons/adaptive-icon.png",
        "monochromeImage": "src/assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.micka_mocka.ExpoNasaApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "src/assets/icons/splash-icon-dark.png",
          "imageSize": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "src/assets/icons/splash-icon-light.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8e85d7b-bcd5-4059-b4e0-9b3bc20c49bf"
      }
    },
    "owner": "micka_mocka"
  }
}
